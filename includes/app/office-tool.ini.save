[office-tool-standard]
distro = Office Tool Plus
category = app
listvers = 3
location = github-release/YerongAI/Office-Tool/Office Tool Plus v*/Office_Tool_v*
pattern = github-release/YerongAI/Office-Tool/Office Tool Plus v([\d\.]+)/Office_Tool_v[\d\.]+_([a-zA-Z0-9]+)\.(zip|7z)
version = $1
platform = $2
type = $3

[office-tool-runtime]
distro = Office Tool Plus
category = app
listvers = 3
location = github-release/YerongAI/Office-Tool/Office Tool Plus v*/Office_Tool_with_runtime_v*
pattern = github-release/YerongAI/Office-Tool/Office Tool Plus v([\d\.]+)/Office_Tool_with_runtime_v[\d\.]+_([a-zA-Z0-9]+)\.(zip|7z)
version = $1
platform = $2-with-
type = $3
